# Copy to .env and fill in. .env is gitignored — this repo is public.
# Every value below has a working default except CBE_API_KEY, which the
# register lookups need.

# --- Required -----------------------------------------------------------

# CBE API key, from https://cbeapi.be — free tier is enough for personal use.
# Without it the app still runs, but it can only answer from what the graph
# already holds; every new lookup fails.
CBE_API_KEY=

# --- Database -----------------------------------------------------------

# Password for the bundled Neo4j container. Change it before first start:
# it is baked into the database on the first run, so changing it afterwards
# means also resetting the volume (docker compose down -v).
NEO4J_PASSWORD=openabox-local

# --- Network ------------------------------------------------------------

# Which interface the containers publish on. The default reaches every
# interface, so the stack is available to the rest of your network. Set it to
# 127.0.0.1 to keep it to the machine it runs on — worth doing, since filings
# contain private individuals' home addresses and there is no authentication
# in front of the API.
OPENABOX_BIND=0.0.0.0

# Host ports. Change these if something else already listens there.
OPENABOX_API_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Data sources -------------------------------------------------------

# Optional. Shareholder, director and financial data come from the National
# Bank's Central Balance Sheet Office. Left blank, the app uses the public
# Consult portal, which needs no credentials but whose terms rule out
# systematic downloading — fine for interactive lookups, not for bulk.
# Setting a key switches to the official web services (the "Authentic Data
# Query" product is free of charge, but needs a subscription with the NBB and
# an account at https://developer.cbso.nbb.be).
CBSO_SUBSCRIPTION_KEY=

# --- Caching and language ------------------------------------------------

# How long a hydrated company record is trusted before re-fetching from the
# CBE. The register changes slowly.
OPENABOX_CACHE_TTL_DAYS=90

# How long ownership and financial data are trusted before re-fetching.
# Filings change once a year, so this is deliberately longer than the CBE TTL.
OPENABOX_CBSO_TTL_DAYS=180

# Language for register labels: nl, fr or de.
OPENABOX_LANG=nl

# --- Neo4j memory --------------------------------------------------------

# Defaults suit a host with a few GB to spare. Lower them on a small machine.
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G
